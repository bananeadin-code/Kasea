# ============================================================================
# Kasea Store — Plantilla de variables de entorno
# ============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
#   cp .env.example .env
#
# El archivo `.env` está en .gitignore: NUNCA se sube al repo (ni a Lovable).
# En producción, estas variables se configuran en el panel del hosting
# (Cloudflare Pages / Netlify) y en Supabase, NO en un archivo.
#
# Regla de oro:
#   - Claves PÚBLICAS (prefijo VITE_): viajan al navegador. Sin problema.
#   - Claves SECRETAS (sin VITE_): solo en el servidor. Jamás en el cliente.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase — PÚBLICO (cliente). Seguro exponer en el bundle del navegador.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_PROJECT_ID="TU-PROYECTO"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REEMPLAZAR"

# ----------------------------------------------------------------------------
# Google Analytics 4 — PÚBLICO (cliente). Measurement ID (G-XXXXXXXXXX).
# Vacío = GA desactivado (y sin banner de cookies). La analítica SOLO se activa
# tras aceptar cookies. En producción se configura en el panel de Render para
# que Vite lo inyecte en el build (los VITE_ se resuelven en tiempo de build).
# ----------------------------------------------------------------------------
VITE_GA_ID="G-QT6L4T9PEK"

# ----------------------------------------------------------------------------
# Supabase — SERVIDOR (server functions). Mismos valores públicos que arriba,
# pero leídos con process.env en el runtime del servidor (Nitro).
# ----------------------------------------------------------------------------
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_PROJECT_ID="TU-PROYECTO"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REEMPLAZAR"

# SECRETO. Bypassa RLS. Úsalo SOLO en el servidor (seed, webhook, tareas admin).
# Se obtiene en: Supabase > Project Settings > API > service_role secret.
# NO tiene prefijo VITE_ a propósito: no debe llegar nunca al navegador.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_REEMPLAZAR"

# ----------------------------------------------------------------------------
# Stripe — pagos con tarjeta (Visa/MasterCard). EMPEZAR SIEMPRE EN MODO TEST.
# Guía para crear la cuenta y obtener las claves: ver DEPLOY.md.
# ----------------------------------------------------------------------------
# PÚBLICO (cliente): clave publicable de test (pk_test_...).
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_REEMPLAZAR"

# SECRETO (servidor): clave secreta de test (sk_test_...). Crea la sesión de pago.
STRIPE_SECRET_KEY="sk_test_REEMPLAZAR"

# SECRETO (servidor): secreto de firma del webhook (whsec_...).
# Verifica que los eventos vienen de Stripe. Se obtiene al crear el webhook.
STRIPE_WEBHOOK_SECRET="whsec_REEMPLAZAR"

# ----------------------------------------------------------------------------
# Resend — correo de confirmación de pedido. (Se usará en la Fase 4.)
# ----------------------------------------------------------------------------
# SECRETO (servidor): API key de Resend.
RESEND_API_KEY="re_REEMPLAZAR"
# Remitente verificado en Resend (dominio propio). Ej. dominio del cliente: kasea.es
RESEND_FROM_EMAIL="Kasea Store <pedidos@kasea.es>"
# Correo del admin para avisos de nuevas órdenes (OPCIONAL / fallback).
# Lo normal es configurarlo en el panel: Admin → Ajustes. Esta variable solo
# se usa si ese campo está vacío.
ADMIN_NOTIFY_EMAIL=""

# ----------------------------------------------------------------------------
# Envío (RESPALDO). La tarifa y el umbral reales se editan en el PANEL DE ADMIN
# (tabla shop_settings). Estos valores solo se usan si esa tabla no existiera.
# Importes en CÉNTIMOS de euro.
# ----------------------------------------------------------------------------
# Envío gratis a partir de este importe de subtotal (5500 = 55,00 €).
SHIPPING_FREE_THRESHOLD_CENTS="5500"
# Tarifa de envío por debajo del umbral (699 = 6,99 €).
SHIPPING_FLAT_CENTS="699"
# URL pública del sitio, para las redirecciones de éxito/cancelación de Stripe.
SITE_URL="http://localhost:8080"
